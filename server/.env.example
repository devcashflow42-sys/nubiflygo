# ==========================================
# NUBIFLYGO - SERVER ENVIRONMENT
# Copia este archivo como .env y rellénalo. NUNCA subas .env al repositorio.
# ==========================================

# Aplicación
APP_NAME=NubiFlyGo
NODE_ENV=development
PORT=8080

# PostgreSQL - Neon Database
# (el nombre de la base "ritmogo" es un recurso real con datos: no se renombra)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/ritmogo?sslmode=require&channel_binding=require"

# Neon REST API (opcional, no lo usa el servidor por ahora)
NEON_API_URL="https://ep-xxxx.apirest.c-7.us-east-2.aws.neon.tech/ritmogo/rest/v1"

# Almacenamiento de archivos: 's3' (Neon/S3) o 'local' (carpeta en disco, solo para pruebas)
STORAGE_PROVIDER=s3
# Bucket real con los archivos de los usuarios: conserva su nombre actual.
STORAGE_BUCKET=ritmogo
MAX_FILE_SIZE_MB=100

# S3-Compatible Storage - Neon (solo si STORAGE_PROVIDER=s3)
AWS_ENDPOINT_URL_S3="https://xxxx.storage.c-7.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_SECRET_ACCESS_KEY"
AWS_REGION="us-east-2"

# Autenticación (genera uno largo y aleatorio, p. ej.: openssl rand -hex 32)
JWT_SECRET="GENERATE_SECURE_RANDOM_SECRET"
# Días de validez de la sesión (cookie httpOnly)
SESSION_DAYS=7
# Transición de la cookie de sesión ritmogo_session → nubiflygo_session.
# "on" acepta la antigua y la cambia sola por la nueva; "off" ya no la acepta.
LEGACY_SESSION_COOKIE=on

# Orígenes del frontend permitidos por CORS (separados por comas).
# Si el servidor sirve también las páginas (mismo dominio), puede quedar vacío.
ALLOWED_ORIGINS="https://nubiflygo.com,https://www.nubiflygo.com,http://localhost:8080"

# Correos de administrador separados por comas (no pueden registrarse con contraseña)
ADMIN_EMAILS=""

# Mercado Pago (suscripciones). Panel: https://www.mercadopago.com.mx/developers/panel/app
MP_ACCESS_TOKEN=""        # Access Token de producción (APP_USR-...) — SECRETO
MP_WEBHOOK_SECRET=""      # Clave secreta de Webhooks (para validar la firma de los avisos)
APP_URL="https://nubiflygo.com"   # Dominio oficial: enlaces compartidos y regreso de pagos
